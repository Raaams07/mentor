# Dependencies
node_modules/

# Build output
dist/
build/
.cache/

# Logs
*.log
npm-debug.log*

# OS cruft
.DS_Store
Thumbs.db

# Excel lock files (created while a workbook is open)
~$*.xlsx
~$*.xls

# Env / secrets
.env
.env.*
!.env.example

# Sheet-memory local store (dev/test data, not source)
src/sheet-classifier/data/

# Real company GST data used for local validation only — never committed
src/demo-data/GST_2A_Books_Demo.xlsx
src/demo-data/2A reco(April-Aug21) BST.xlsx
src/demo-data/2A Reco till Feb.xlsx
src/demo-data/GST Reco Sheeet up to Dec.xlsx
src/gst-reconciliation/ground-truth/

# Local Anthropic API key for the vendor-suggestion proxy (server/mentor-suggestions-proxy.js) — never committed
server/.anthropic-api-key

# Column-pattern (Tier 1 shared) memory local store (dev/test data, not source)
server/data/

# Vercel local project-link metadata (account/org/project IDs) — written if
# `vercel link` is ever run locally; never committed
.vercel/
