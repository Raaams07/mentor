{
  "name": "office-addin-taskpane-js",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Raaams07/mentor.git"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "test:classifier": "node src/sheet-classifier/regression-test.js",
    "test:sheet-memory": "node src/sheet-classifier/sheet-memory-test.js",
    "test:gst-reconciliation": "node src/gst-reconciliation/gst-reconciliation-test.js",
    "test:gst-wrong-head": "node src/gst-reconciliation/wrong-head-detector-test.js",
    "test:gst-cross-sheet-wrong-head": "node src/gst-reconciliation/cross-sheet-wrong-head-detector-test.js",
    "test:gst-extra-invoice": "node src/gst-reconciliation/extra-invoice-detector-test.js",
    "test:gst-invoice-number-normalizer": "node src/gst-reconciliation/invoice-number-normalizer-test.js",
    "test:gst-rcm": "node src/gst-reconciliation/rcm-detector-test.js",
    "test:gst-ineligible-itc": "node src/gst-reconciliation/ineligible-itc-detector-test.js",
    "test:gst-duplicates": "node src/gst-reconciliation/duplicate-invoice-detector-test.js",
    "test:gst-description-field": "node src/gst-reconciliation/description-field-test.js",
    "test:gst-summary": "node src/gst-reconciliation/gst-summary-builder-test.js",
    "test:vendor-itc-screening": "node server/vendor-itc-screening-test.js",
    "test:ineligible-itc-vendor-extraction": "node src/taskpane/ineligible-itc-vendor-extraction-test.js",
    "test:gst-source-data-hash": "node src/taskpane/gst-source-data-hash-test.js",
    "test:gst-topissue-readback": "node src/taskpane/gst-report-writer-topissue-readback-test.js",
    "test:gst-suggestions-proxy": "node server/mentor-suggestions-proxy-test.js",
    "gst-suggestions-proxy": "node server/mentor-suggestions-proxy.js",
    "validate": "office-addin-manifest validate manifest.xml",
    "watch": "webpack --mode development --watch"
  },
  "dependencies": {
    "@microsoft/office-js": "^1.1.110",
    "core-js": "^3.36.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.25.4",
    "@types/office-js": "^1.0.377",
    "@types/office-runtime": "^1.0.35",
    "acorn": "^8.11.3",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "eslint-plugin-office-addins": "^4.0.3",
    "file-loader": "^6.2.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-cli": "^2.0.3",
    "office-addin-debugging": "^6.0.3",
    "office-addin-dev-certs": "^2.0.3",
    "office-addin-lint": "^3.0.3",
    "office-addin-manifest": "^2.0.3",
    "office-addin-prettier-config": "^2.0.1",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "5.1.0",
    "xlsx": "^0.18.5"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions",
    "ie 11"
  ]
}
